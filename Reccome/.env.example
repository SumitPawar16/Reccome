# Is file ko copy karke ".env" naam se banao aur apni asli values daalo.
# ".env" ko GitHub pe kabhi upload mat karna (.gitignore mein already hai).
FLASK_SECRET_KEY=your_long_random_secret_key
MONGODB_URI=your_mongodb_connection_string
MAIL_SENDER_EMAIL=your_gmail_address
MAIL_SENDER_PASSWORD=your_16_digit_gmail_app_password
TMDB_API_KEY=your_tmdb_api_key
